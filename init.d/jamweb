#!/bin/sh /etc/rc.common
# JamWeb (Python + SQLite CMS) procd service.

START=95
STOP=10
USE_PROCD=1

start_service() {
	: "${JAMWEB_PORT:=8080}"

	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/lib/jamweb/app.py \
		--db /etc/jamweb/jamweb.db serve --host 0.0.0.0 --port "$JAMWEB_PORT"
	procd_set_param env \
		JAMWEB_BASE="${JAMWEB_BASE:-}" \
		JAMWEB_PUBLIC_URL="${JAMWEB_PUBLIC_URL:-}" \
		JAMWEB_MEDIA="${JAMWEB_MEDIA:-/etc/jamweb/media}"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger jamweb
}
